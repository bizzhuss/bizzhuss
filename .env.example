# -----------------------------------------------------------------------------
# Bizzhuss Enterprise Platform - Environment Configuration Template
# -----------------------------------------------------------------------------

# Application Core Settings
APP_NAME="Bizzhuss"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging Configuration
# For Vercel serverless deployment, 'stderr' streams logs directly to Vercel Function logs.
LOG_CHANNEL=stderr
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# Database Connection (External Managed MySQL)
# Note: Local MySQL cannot run on Vercel serverless functions.
# Use an external managed MySQL instance (e.g., PlanetScale, AWS RDS, Aiven, Railway, Supabase MySQL).
DB_CONNECTION=mysql
DB_HOST=your-managed-db-host.com
DB_PORT=3306
DB_DATABASE=bizzhuss
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password
DB_COLLATION=utf8mb4_unicode_ci

# SSL / TLS Database Configuration (Required by most managed cloud databases)
# In Linux / Lambda containers, standard CA cert bundle path is /etc/ssl/certs/ca-certificates.crt
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Session Security Configuration
# On serverless functions, use 'database' (MySQL sessions table) or 'cookie' (encrypted client-side).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache and Queue Driver Settings
CACHE_STORE=database
CACHE_PREFIX=bizzhuss_cache_
QUEUE_CONNECTION=database

# Maintenance Driver Settings
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=database

# Password Hashing
BCRYPT_ROUNDS=12

# File Storage Configuration
# The Vercel filesystem is read-only (except /tmp).
# Persistent file uploads (products, avatars, banners) MUST use an external S3-compatible cloud bucket.
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Mail Service Settings
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Socialite / Google OAuth Settings
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Serverless Cache Paths (Automatically managed by vercel.json)
# APP_CONFIG_CACHE=/tmp/bootstrap/cache/config.php
# APP_EVENTS_CACHE=/tmp/bootstrap/cache/events.php
# APP_PACKAGES_CACHE=/tmp/bootstrap/cache/packages.php
# APP_ROUTES_CACHE=/tmp/bootstrap/cache/routes.php
# APP_SERVICES_CACHE=/tmp/bootstrap/cache/services.php
# VIEW_COMPILED_PATH=/tmp/storage/framework/views

# Frontend (Vite) Public Environment Variables
VITE_APP_NAME="${APP_NAME}"
